{
  "hosting": {
    "site": "unext-desk",
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "version.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  }
}
